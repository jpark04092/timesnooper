<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Timesnooper 백그라운드 서비스"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="자녀 기기 앱 사용시간을 안전하게 백그라운드에서 추적합니다."
        android:textSize="14sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnUsagePermission"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="1. 사용 정보 접근 권한 허용"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnBatteryExemption"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="2. 배터리 절전모드(Doze) 예외 등록"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStartService"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="3. 감시 서비스 및 10시 알람 시작"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStealthMode"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="4. 스텔스 모드 (런처 아이콘 숨김)"
        android:backgroundTint="#7C3AED"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnUnhideIcon"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="5. 스텔스 해제 (홈 화면 아이콘 복구)"
        android:backgroundTint="#2563EB"
        android:layout_marginTop="10dp" />

</LinearLayout>
